flowchart TD
    INPUT["CBClaimVerdicts<br/>(from Step 5)"] --> EID{{"Evidence ID<br/>validity"}}

    EID -->|"Invalid IDs"| WARN1["Warning: evidence ID<br/>not in evidence pool"]
    EID -->|"All valid"| BID

    EID --> BID{{"Boundary ID<br/>validity"}}

    BID -->|"Invalid IDs"| WARN2["Warning: boundary ID<br/>not in boundaries"]
    BID -->|"All valid"| TRUTH

    BID --> TRUTH{{"Truth %<br/>range check"}}

    TRUTH -->|"Out of 0-100"| WARN3["Warning: truthPercentage<br/>out of range"]
    TRUTH -->|"In range"| LABEL

    TRUTH --> LABEL{{"Label-band<br/>matching"}}

    LABEL -->|"Mismatch"| WARN4["Warning: verdict label<br/>does not match expected<br/>for truth% + confidence%"]
    LABEL -->|"Match"| COV

    LABEL --> COV{{"Coverage<br/>completeness"}}

    COV -->|"Gaps found"| WARN5["Warning: claim has<br/>verdict but zero evidence<br/>in coverage matrix"]
    COV -->|"Complete"| PASS["All structural<br/>checks pass"]

    WARN1 --> CONTINUE["Continue to<br/>Gate 4<br/>(non-blocking)"]
    WARN2 --> CONTINUE
    WARN3 --> CONTINUE
    WARN4 --> CONTINUE
    WARN5 --> CONTINUE
    PASS --> CONTINUE

    style WARN1 fill:#fff3e0,stroke:#e65100,color:#000
    style WARN2 fill:#fff3e0,stroke:#e65100,color:#000
    style WARN3 fill:#fff3e0,stroke:#e65100,color:#000
    style WARN4 fill:#fff3e0,stroke:#e65100,color:#000
    style WARN5 fill:#fff3e0,stroke:#e65100,color:#000
    style PASS fill:#c8e6c9,stroke:#2e7d32,color:#000
    style CONTINUE fill:#e3f2fd,stroke:#1565c0,color:#000
