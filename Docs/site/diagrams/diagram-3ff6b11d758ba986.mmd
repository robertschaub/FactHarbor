flowchart LR
  SRC["Source record"] --> LOOKUP["Cache lookup"]
  LOOKUP -->|"hit"| SIG["SourceReliabilitySignal"]
  LOOKUP -->|"miss or stale"| EVAL["LLM source evaluation"]
  EVAL --> STORE["Versioned cache record"]
  STORE --> SIG
  SIG --> EC["EvidenceCorpus"]
  EC --> VER["Verdict adjudication<br/>approved policy only"]
  EC --> LEDGER["Run ledger and diagnostics"]
  VER --> RR["ReportResult<br/>no hidden formula"]

  classDef source fill:#e8f4ff,stroke:#2463a7,color:#08233d
  classDef cache fill:#edf7ed,stroke:#3d8b40,color:#102a12
  classDef policy fill:#fff4d6,stroke:#9a6700,color:#3a2600
  class SRC,SIG,EC source
  class LOOKUP,STORE,LEDGER cache
  class EVAL,VER,RR policy
