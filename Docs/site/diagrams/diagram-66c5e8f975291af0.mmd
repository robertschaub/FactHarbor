flowchart TD
    subgraph JobsList["/jobs - Jobs List Page"]
        JL_JOB["JOB<br/>status, progress<br/>inputPreview<br/>pipelineVariant<br/>createdUtc"]
    end

    subgraph JobDetail["/jobs/id - Job Detail Page"]

        subgraph VerdictBanner["Verdict Banner"]
            JD_OA["OVERALL_ASSESSMENT<br/>truthPercentage, verdict<br/>confidence<br/>truthPercentageRange"]
            JD_VN["VERDICT_NARRATIVE<br/>headline, keyFinding<br/>limitations"]
            JD_TPS["TWO_PANEL_SUMMARY<br/>articleSummary<br/>factharborAnalysis"]
        end

        subgraph BoundarySection["ClaimAssessmentBoundary Tabs"]
            JD_CB["CLAIM_BOUNDARY<br/>name, shortName<br/>methodology, temporal<br/>geographic"]
            JD_BF["BOUNDARY_FINDING<br/>truthPercentage, confidence<br/>evidenceDirection, evidenceCount"]
        end

        subgraph ClaimsSection["Claims Analyzed"]
            JD_AC["ATOMIC_CLAIM<br/>statement, category<br/>centrality, harmPotential"]
            JD_CV["CB_CLAIM_VERDICT<br/>verdict, truthPercentage<br/>confidence, reasoning<br/>harmPotential, isContested<br/>misleadingness"]
        end

        subgraph EvidenceSection["Evidence Panel"]
            JD_EI["EVIDENCE_ITEM<br/>statement, category<br/>sourceTitle, claimDirection<br/>probativeValue"]
            JD_ES["EVIDENCE_SCOPE<br/>(tooltip: methodology<br/>boundaries, geographic)"]
        end

        subgraph SourcesSection["Sources Tab"]
            JD_FS["FETCHED_SOURCE<br/>url, title<br/>trackRecordScore<br/>fetchSuccess"]
        end

        subgraph QualitySection["Quality Panel"]
            JD_QG["QUALITY_GATES<br/>passed, gate1Stats<br/>gate4Stats"]
            JD_AW["ANALYSIS_WARNING<br/>type, severity<br/>message"]
            JD_EQC["EXPLANATION_QUALITY_CHECK<br/>mode, structuralFindings<br/>rubricScores (when rubric)"]
        end

        subgraph SearchSection["Search Queries"]
            JD_SQ["SEARCH_QUERY<br/>query, resultsCount<br/>searchProvider"]
        end
    end

    subgraph Admin["/admin - Admin Pages"]
        AD_HEALTH["Provider Health<br/>state, consecutiveFailures"]
        AD_METRICS["ANALYSIS_METRICS<br/>avgDuration, avgCost<br/>gate1PassRate<br/>gate4HighConfidenceRate"]
        AD_CONFIG["CONFIG_SNAPSHOT<br/>pipelineConfig<br/>searchConfig"]
    end

    JL_JOB -->|"click job"| JobDetail
    JD_AC -->|"has verdict"| JD_CV
    JD_CV -->|"references"| JD_EI
    JD_EI -->|"from"| JD_FS
    JD_CB -->|"findings"| JD_BF

