flowchart TB
    RAW["Raw Evidence<br/>(from LLM extraction)"]

    subgraph P1["Phase 1: Evidence Quality (Pre-Verdict)"]
        L1["LLM Prompt Instructions<br/>(guide extraction quality)"]
        L2["Deterministic Filter<br/>(min length, vague phrases, dedup,<br/>category rules, probative scoring)"]
        L3["Provenance Validation<br/>(reject synthetic/LLM-generated content)"]
    end

    subgraph P2["Phase 2: Verdict Quality (Post-Verdict)"]
        L4["Source Reliability Weighting<br/>(domain credibility 0.0-1.0)"]
        L5["Aggregation Pruning<br/>(tangential, opinion-only,<br/>contestation validation)"]
        L6["Verdict Corrections<br/>(inversion detection,<br/>direction mismatch fix)"]
    end

    CLEAN["Validated Verdict<br/>(published to report)"]

    RAW --> L1 --> L2 --> L3 --> L4 --> L5 --> L6 --> CLEAN

    style RAW fill:#ffcdd2,stroke:#b71c1c,color:#000
    style CLEAN fill:#c8e6c9,stroke:#2e7d32,color:#000
