flowchart TB
  CC["ClaimContract<br/>selected AtomicClaims"] --> QP["Query plan<br/>LLM semantic planning"]
  QP --> SEARCH["Search providers<br/>structural provider calls"]
  SEARCH --> FETCH["Source fetch and extraction<br/>status, retries, trace"]
  FETCH --> APP["Relevance and applicability<br/>LLM judgment"]
  APP --> EXTRACT["Evidence extraction<br/>EvidenceItem + EvidenceScope"]
  EXTRACT --> SR["Source reliability signal<br/>LLM-owned where semantic;<br/>cached and versioned"]
  EXTRACT --> EC["EvidenceCorpus"]
  SR --> EC
  EC --> SUFF["SufficiencyAssessment<br/>continue, refine, caveat, damage"]
  SUFF --> BS["BoundarySet input"]

  WARN["Warning policy"] --> FETCH
  WARN --> SUFF

  classDef semantic fill:#e8f4ff,stroke:#2463a7,color:#08233d
  classDef structural fill:#edf7ed,stroke:#3d8b40,color:#102a12
  classDef gate fill:#fff4d6,stroke:#9a6700,color:#3a2600
  class QP,APP,EXTRACT,SR semantic
  class SEARCH,FETCH,EC structural
  class SUFF,WARN gate
