flowchart TD
    INPUT["AtomicClaim<br/>from Pass 2"] --> FIDELITY{{"passedFidelity?<br/>(Claim faithful to<br/>original input meaning)"}}

    FIDELITY -->|"No"| FILTERED["FILTERED<br/>(evidence-contaminated<br/>or hallucinated)"]
    FIDELITY -->|"Yes"| OPINION{{"passedOpinion?<br/>(Factual, not pure<br/>opinion or prediction)"}}

    OPINION -->|"No"| SPEC_CHECK{{"passedSpecificity?"}}
    OPINION -->|"Yes"| SPEC{{"specificityScore<br/>>= UCM minimum<br/>(default 0.6)"}}

    SPEC_CHECK -->|"No (fails both)"| FILTERED2["FILTERED<br/>(opinion + not specific)"]
    SPEC_CHECK -->|"Yes"| SPEC

    SPEC -->|"Yes"| GROUNDING["Check groundingQuality"]
    SPEC -->|"No, grounded<br/>(moderate/strong/weak)"| FILTERED3["FILTERED<br/>(too vague, grounding<br/>available but insufficient)"]
    SPEC -->|"No, ungrounded<br/>(groundingQuality=none)"| EXEMPT["EXEMPT from<br/>specificity filter<br/>(cold extraction)"]

    EXEMPT --> GROUNDING

    GROUNDING --> GQ_STRONG["strong:<br/>Fully grounded in<br/>preliminary evidence"]
    GROUNDING --> GQ_MODERATE["moderate:<br/>Evidence themes referenced<br/>but lacks specifics"]
    GROUNDING --> GQ_WEAK["weak:<br/>Acceptable for claims<br/>input article states explicitly"]
    GROUNDING --> GQ_NONE["none:<br/>Cold extraction — may indicate<br/>poor preliminary search"]

    GQ_STRONG --> PASSED["PASSED<br/>(proceed to research)"]
    GQ_MODERATE --> PASSED
    GQ_WEAK --> FLAGGED["PASSED with<br/>monitoring flag"]
    GQ_NONE --> FLAGGED
    FLAGGED --> PASSED

    PASSED --> RETRY_CHECK{{"Retry threshold<br/>exceeded?<br/>(> 50% specificity<br/>failures)"}}
    RETRY_CHECK -->|"Yes"| RETRY_WARN["Logged: retry deferred<br/>to v1.1"]
    RETRY_CHECK -->|"No"| DONE["Claims proceed<br/>to Stage 2"]
    RETRY_WARN --> DONE

    style FILTERED fill:#ffcdd2,stroke:#c62828,color:#000
    style FILTERED2 fill:#ffcdd2,stroke:#c62828,color:#000
    style FILTERED3 fill:#ffcdd2,stroke:#c62828,color:#000
    style PASSED fill:#c8e6c9,stroke:#2e7d32,color:#000
    style FLAGGED fill:#fff3e0,stroke:#e65100,color:#000
    style EXEMPT fill:#e3f2fd,stroke:#1565c0,color:#000
    style RETRY_WARN fill:#fff3e0,stroke:#e65100,color:#000
