flowchart TB
    subgraph Client["Client Layer"]
        BROWSER["Web Browser"]
    end

    subgraph NextJS["Next.js Web App (port 3000)"]
        UI["UI Pages<br/>/analyze, /jobs, /admin"]
        FH_API["Proxy API Routes<br/>/api/fh/*"]
        INTERNAL["Internal API<br/>/api/internal/run-job"]
        AKEL["ClaimAssessmentBoundary Pipeline<br/>claimboundary-pipeline.ts"]
        SHARED["Shared Modules<br/>evidence-filter, aggregation,<br/>quality-gates, source-reliability"]
        CONFIG_DB[("config.db<br/>UCM Config")]
        SR_DB[("source-reliability.db<br/>SR Cache")]
    end

    subgraph DotNet[".NET API (port 5000)"]
        CONTROLLERS["Controllers<br/>Analyze, Jobs, Health"]
        SERVICES["Services<br/>JobService, RunnerClient"]
        MAIN_DB[("factharbor.db<br/>Jobs & Events")]
    end

    subgraph External["External Services"]
        LLM["LLM Providers<br/>Anthropic, OpenAI, Google, Mistral"]
        SEARCH["Search Providers<br/>Google CSE, SerpAPI, Brave,<br/>Wikipedia, Semantic Scholar,<br/>Google Fact Check"]
    end

    BROWSER --> UI
    UI --> FH_API
    FH_API --> CONTROLLERS
    CONTROLLERS --> SERVICES
    SERVICES --> MAIN_DB
    SERVICES -->|"POST /api/internal/run-job<br/>(with retry + backoff)"| INTERNAL
    INTERNAL --> AKEL
    AKEL --> SHARED
    AKEL --> LLM
    AKEL --> SEARCH
    AKEL --> CONFIG_DB
    SHARED --> SR_DB

