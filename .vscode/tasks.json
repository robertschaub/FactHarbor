{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "msbuild",
        "${workspaceFolder}/apps/api/FactHarbor.Api.csproj",
        "/t:Compile",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/apps/api/FactHarbor.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary;ForceNoAlign"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/apps/api/FactHarbor.Api.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Documentation: Preview",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "mkdocs",
        "serve",
        "--dev-addr",
        "127.0.0.1:8000"
      ],
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
